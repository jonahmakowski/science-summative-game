[gd_scene format=3 uid="uid://cbx27dswahttw"]

[sub_resource type="GDScript" id="GDScript_rniwk"]
script/source = "extends HBoxContainer

@onready var player: Label = %Player
@onready var money: Label = %Money
@onready var player_status: Label = %PlayerStatus

@export var player_text: String:
	set(val):
		player_text = val
		if is_node_ready():
			player.text = player_text
@export var money_text: String:
	set(val):
		money_text = val
		if is_node_ready():
			money.text = money_text
@export var player_status_text: String:
	set(val):
		player_status_text = val
		if is_node_ready():
			player_status.text = player_status_text

func _ready() -> void:
	player.text = player_text
	money.text = money_text
	player_status.text = player_status_text
"

